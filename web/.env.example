# Backend API URL (default = deployed Railway)
VITE_API_URL=https://noalone-api-production.up.railway.app/api/v1

# Socket.IO base (without /chat namespace)
VITE_SOCKET_URL=https://noalone-api-production.up.railway.app

# Test-only helper key (matches backend TEST_API_KEY) — leave blank in prod
VITE_TEST_API_KEY=noalone-playwright-test-2026

# Google OAuth Web Client ID — must be a Web Application credential with
# http://localhost:5173/oauth/google as an authorized redirect URI.
# Used for both sign-in and the Calls "Authorize Google" flow.
VITE_GOOGLE_CLIENT_ID=

# When true, the "Authorize Google for Calls" CTA uses a frontend mock and
# the call initiate button generates a fake Meet link — purely for demo/test.
VITE_MOCK_CALLS=true
